# ─────────────────────────────────────────────────────────────
# GrowthRush — environment configuration
# Copy this file to `.env` and edit the values.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon.tech PostgreSQL) ─────────────────────────
# Create a free project at https://neon.tech → copy the pooled
# connection string and paste it here:
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# SQLite (local quick demo — use with the default prisma/schema.prisma)
# DATABASE_URL="file:./db/custom.db"

# ── Cron / order engine ─────────────────────────────────────
# Secret required by POST /api/cron/tick (order processing worker).
# Create a cron job (every minute) on your hosting:
#   curl -s -X POST http://127.0.0.1:3000/api/cron/tick -H "x-cron-secret: CHANGE-ME"
CRON_SECRET="change-me-to-a-long-random-string"

# ── Realtime service (optional) ─────────────────────────────
# mini-services/realtime — WebSocket gateway for live order updates (port 3032).
# REALTIME_PORT=3032

# NOTE: SMTP / email is configured from the Admin panel
# (Admin → Email & Notifications → Provider) — no env vars needed.
# Without SMTP the platform keeps a built-in Outbox (Admin → Logs).
